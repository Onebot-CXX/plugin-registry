{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onebot-cxx.github.io/schemas/actor-registry-entry.schema.json",
  "title": "OBCX actor registry entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "name", "version", "abi", "artifact", "dependencies",
    "compatibility", "publication", "metadata"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "version": {"type": "string"},
    "abi": {"const": 2},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "entrypoint", "platforms", "install_directory", "files"],
      "properties": {
        "name": {"type": "string"},
        "kind": {"const": "shared-library"},
        "entrypoint": {"const": "obcx_create_actor_v2"},
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/platform"}
        },
        "install_directory": {"const": "lib/obcx/actors"},
        "files": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "linux-x86_64": {"$ref": "#/$defs/file"},
            "linux-arm64": {"$ref": "#/$defs/file"}
          }
        }
      }
    },
    "dependencies": {"type": "object"},
    "compatibility": {
      "type": "object",
      "required": [
        "obcx", "actor_abi_min", "actor_abi_max", "cpp_standard",
        "compiler", "reflection_macro", "input_contract_schema"
      ],
      "properties": {
        "obcx": {"type": "string"},
        "actor_abi_min": {"const": 2},
        "actor_abi_max": {"const": 2},
        "cpp_standard": {"const": 26},
        "compiler": {"const": "gcc>=16.1"},
        "reflection_macro": {"const": 202506},
        "input_contract_schema": {"const": 1}
      },
      "additionalProperties": false
    },
    "publication": {
      "type": "object",
      "required": ["repository", "license", "description"],
      "properties": {
        "repository": {"type": "string", "format": "uri", "pattern": "^https://"},
        "homepage": {"type": "string", "format": "uri", "pattern": "^https://"},
        "license": {"type": "string"},
        "description": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^entries/.+/actor\\.toml$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "$defs": {
    "platform": {
      "enum": [
        "linux-x86_64", "linux-arm64"
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "url"],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    }
  }
}
